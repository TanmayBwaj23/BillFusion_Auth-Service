# BillFusion Auth Service Environment Configuration
# Copy this file to .env and update the values

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
PROJECT_NAME="BillFusion Auth Service"
VERSION=1.0.0

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# Generate a strong secret key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-in-production-must-be-32-chars-min
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Password Policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_SPECIAL_CHARS=true

# =============================================================================
# DATABASE SETTINGS
# =============================================================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres123@localhost:5432/billfusion_auth
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
POSTGRES_PASSWORD=postgres123

# =============================================================================
# REDIS SETTINGS
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=redis123

# =============================================================================
# GOOGLE OAUTH SETTINGS
# =============================================================================
# Get these from Google Cloud Console
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# =============================================================================
# CORS SETTINGS
# =============================================================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]
ALLOWED_HOSTS=["localhost","127.0.0.1","auth-service"]

# =============================================================================
# LOGGING SETTINGS
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# =============================================================================
# MONITORING SETTINGS
# =============================================================================
PROMETHEUS_METRICS_PATH=/metrics
GRAFANA_URL=http://localhost:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

# =============================================================================
# RATE LIMITING SETTINGS
# =============================================================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# =============================================================================
# EMAIL SETTINGS
# =============================================================================
# SMTP Configuration (Optional - for email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true

# =============================================================================
# FILE STORAGE SETTINGS
# =============================================================================
FILE_STORAGE_PATH=./uploads
MAX_FILE_SIZE=10485760

# =============================================================================
# API DOCUMENTATION
# =============================================================================
API_DOCS_ENABLED=true

# =============================================================================
# DOCKER BUILD SETTINGS
# =============================================================================
BUILD_DATE=2023-01-01T00:00:00Z
VCS_REF=main
VERSION=1.0.0

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Set to true in development for auto-reload
RELOAD=true

# =============================================================================
# PRODUCTION SETTINGS (Override in production)
# =============================================================================
# ENVIRONMENT=production
# DEBUG=false
# SECRET_KEY=your-production-secret-key-must-be-very-secure
# DATABASE_URL=postgresql+asyncpg://username:password@prod-db:5432/billfusion_auth
# CORS_ORIGINS=["https://yourdomain.com"]
# ALLOWED_HOSTS=["yourdomain.com","www.yourdomain.com"]
# LOG_LEVEL=WARNING
# SMTP_HOST=your-production-smtp-host
# GRAFANA_ADMIN_PASSWORD=secure-grafana-password

# =============================================================================
# TESTING SETTINGS
# =============================================================================
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/billfusion_auth_test
# TEST_REDIS_URL=redis://localhost:6379/1

